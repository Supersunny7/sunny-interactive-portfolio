# Optional: leave SANITY_PROJECT_ID blank to run with the bundled local fallback.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-03-01
# Server-only. Never use a SANITY_STUDIO_ prefix for either secret.
SANITY_API_READ_TOKEN=
PREVIEW_SESSION_SECRET=
# Optional temporary migration credential; revoke it after migration.
SANITY_IMPORT_TOKEN=
SITE_URL=http://127.0.0.1:5190
# Studio: configure YOUR project and origins, not the original owner's project.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_PREVIEW_URL=http://127.0.0.1:5190
SANITY_STUDIO_STAGING_PREVIEW_URL=http://127.0.0.1:5191
SANITY_STUDIO_HOSTNAME=
