{
  "name": "sunny-portfolio-content",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node tools/build.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "studio:dev": "sanity dev --host 127.0.0.1 --port 3333",
    "studio:build": "sanity build studio-dist",
    "studio:deploy": "sanity deploy",
    "import": "node --env-file-if-exists=.env --import tsx tools/import.ts",
    "preview": "node --env-file-if-exists=.env tools/serve.mjs"
  },
  "dependencies": {
    "@sanity/client": "8.10.1",
    "@sanity/image-url": "2.1.1",
    "@sanity/preview-url-secret": "4.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.20.0",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "linkedom": "0.18.14",
    "netlify-cli": "27.14.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
